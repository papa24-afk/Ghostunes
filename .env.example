# ==============================================================================
# Ghosttunes — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and provide your credentials where applicable.
# DO NOT commit your actual '.env' file containing real secrets to version control.
# ==============================================================================

# Spotify Provider Integration (Optional)
# Used for importing user playlists and personalized library sync.
# 1. Register a developer application at: https://developer.spotify.com/dashboard
# 2. Add Redirect URI: http://localhost:5173/spotify-callback
# 3. Paste your 32-character Client ID & Secret below:
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:5173/spotify-callback

# Deezer Integration (Optional)
# Used for private Deezer playlist sync: https://developers.deezer.com/
# DEEZER_APP_ID=your_deezer_app_id_here
# DEEZER_APP_SECRET=your_deezer_app_secret_here

# Apple MusicKit on the Web (Optional)
# Used for personalized Apple Music library importing (signed JWT Developer Token):
# APPLE_DEVELOPER_TOKEN=your_apple_developer_token_here

# Local Server Configuration
PORT=3001
HOST=127.0.0.1
